{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "the-singles-forum",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-10-22",
  "workers_dev": true,
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "tsf-content" }],
  "vars": { "AUTH_MODE": "standalone" }
}
