{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "the-singles-forum",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-10-22",
  "workers_dev": true,
  "d1_databases": [{ "binding": "DB", "database_name": "tsf-content", "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID" }],
  "vars": { "AUTH_MODE": "standalone" }
}
