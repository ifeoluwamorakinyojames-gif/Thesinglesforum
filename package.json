{
  "name": "the-singles-forum",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env src/server.mjs",
    "start": "node --env-file-if-exists=.env src/server.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/site.test.mjs",
    "password": "node scripts/password.mjs",
    "build:worker": "node scripts/build-hosted.mjs",
    "test:worker": "node scripts/test-hosted.mjs && node --test tests/standalone.test.mjs && node --test tests/d1.test.mjs",
    "password:worker": "node scripts/worker-password.mjs",
    "deploy:worker": "npm run build:worker && wrangler deploy",
    "preview:worker": "npm run build:worker && wrangler dev"
  },
  "devDependencies": {
    "wrangler": "4.92.0"
  }
}
