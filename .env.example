HOST=127.0.0.1
PORT=3000
SITE_URL=http://localhost:3000
# Run npm run password to create the hash. Never store a real password here.
ADMIN_PASSWORD_HASH=
# Generate a random value: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Set an absolute persistent disk path in production.
DATA_DIR=./data
# Production requires HTTPS SITE_URL and credentials.
NODE_ENV=development
